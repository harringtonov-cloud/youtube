[Unit]
Description=YouTube Engagement Automation Tester
After=network.target

[Service]
Type=simple
User=ytester
WorkingDirectory=/opt/yt-engagement-tester
Environment=PLAYWRIGHT_BROWSERS_PATH=/opt/yt-engagement-tester/.browsers
ExecStart=/opt/yt-engagement-tester/.venv/bin/python -m app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
