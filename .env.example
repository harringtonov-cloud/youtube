# Скопируйте в .env и отредактируйте:  cp .env.example .env

# ОБЯЗАТЕЛЬНО задайте свой длинный секретный токен для входа в веб-панель.
# Если оставить пустым, токен будет сгенерирован при старте и выведен в лог.
ADMIN_TOKEN=

HOST=0.0.0.0
PORT=8000

# Куда сохраняются история (SQLite) и скриншоты
DATA_DIR=./data

# Сколько прогонов выполняется одновременно (на малом VPS оставьте 1)
MAX_CONCURRENT_RUNS=1

# Автовосстановление: число попыток на сценарий при сбоях инфраструктуры
MAX_ATTEMPTS=3
ACTION_TIMEOUT_MS=10000
SCENARIO_TIMEOUT_S=90

# Порог «просмотра» в песочнице (мс), как у настоящих плееров — просмотр
# засчитывается только после этого времени воспроизведения
SANDBOX_VIEW_THRESHOLD_MS=2000

# ---------- YouTube Data API / Google OAuth (бесплатно, см. README) ----------
# API-ключ: чтение публичных данных (просмотры, лайки, комментарии) без входа
YOUTUBE_API_KEY=
# OAuth-клиент типа «TV и устройства с ограниченным вводом» (вход по коду)
# или «Веб-приложение» (нужно для комментариев). Один и тот же ID/секрет подходят только своему типу.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Только для веб-входа: HTTPS-адрес вашей панели + /oauth/callback
GOOGLE_REDIRECT_URI=
# Как часто снимать статистику отслеживаемых видео (минуты, не меньше 5; 1 ед. квоты за запрос)
YT_POLL_INTERVAL_MIN=30
# Предохранитель: максимум операций записи (лайк/комментарий/правка) в сутки
YT_WRITE_LIMIT_PER_DAY=20
# Суточная квота вашего проекта (по умолчанию у Google 10000) — для индикатора в панели
YT_DAILY_QUOTA=10000

# true, если панель открыта по HTTPS (рекомендуется, см. README)
COOKIE_SECURE=false

LOG_LEVEL=info
