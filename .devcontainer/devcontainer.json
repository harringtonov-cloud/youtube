{
  "name": "YT Engagement Tester (Python 3.12 + Playwright)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {}
  },

  // Выполняется один раз при первом создании codespace: ставит зависимости и браузер.
  "onCreateCommand": "bash .devcontainer/setup.sh",

  // Выполняется при каждом запуске/восстановлении codespace (после паузы, перезапуска машины).
  "postStartCommand": "bash .devcontainer/post-start.sh",

  // Порт веб-панели. "notify" — Codespaces покажет тост со ссылкой, когда порт откроется.
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "YT Engagement Tester — веб-панель",
      "onAutoForward": "notify"
    }
  },

  // Два экземпляра Chromium (автотесты и ручной браузер) требуют памяти.
  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "32gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/.venv/bin/python",
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },

  "remoteUser": "vscode"
}
